<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Administrar <%= titulo %></title>

    <link rel="stylesheet" href="/library/styles.css">

</head>

<body>

    <h1>Administrar <%= titulo %></h1>

    <p>
        Administrador:
        <strong><%= usuario.nombre %></strong>
    </p>

    <p>
        <a href="/library/admin">
            Volver al panel
        </a>
    </p>

    <p>
        <a href="/library/admin/catalogos/<%= tipo %>/nuevo">
            Nuevo registro
        </a>
    </p>

    <hr>

    <h2>Registros</h2>

    <table border="1" cellpadding="6">

        <thead>

            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>

        </thead>

        <tbody>

            <% registros.forEach(registro => { %>

                <tr>

                    <td>
                        <%= registro.id %>
                    </td>

                    <td>
                        <%= registro.nombre %>
                    </td>

                    <td>

                        <a
                            href="/library/admin/catalogos/<%= tipo %>/<%= registro.id %>/editar"
                        >
                            Editar
                        </a>

                        <br><br>

                        <form
                            action="/library/admin/catalogos/<%= tipo %>/<%= registro.id %>/eliminar"
                            method="POST"
                            onsubmit="return confirm('Â¿Seguro que deseas eliminar este registro?');"
                        >

                            <button type="submit">
                                Eliminar
                            </button>

                        </form>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

    <hr>

    <p>
        <a href="/library/admin">
            Volver al panel de administraciÃ³n
        </a>
    </p>

</body>

</html>
