<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>CatÃ¡logo de libros</title>

    <link rel="stylesheet" href="/library/styles.css">

</head>

<body>

    <h1>CatÃ¡logo de libros</h1>

    <p>
        Bienvenido,
        <strong><%= usuario.nombre %></strong>
    </p>

    <p>
        Rol:
        <strong><%= usuario.rol %></strong>
    </p>

    <% if (usuario.rol === 'administrador') { %>

        <p>
            <a href="/library/admin">
                Panel de administraciÃ³n
            </a>
        </p>

    <% } %>

    <hr>

    <h2>Buscar libro</h2>

    <form
        action="/library/catalogo"
        method="GET"
    >

        <label for="busqueda">
            TÃ­tulo o ISBN:
        </label>

        <input
            type="text"
            id="busqueda"
            name="busqueda"
            value="<%= busqueda %>"
        >

        <button type="submit">
            Buscar
        </button>

        <a href="/library/catalogo">
            Mostrar todos
        </a>

    </form>

    <hr>

    <p>
        Libros encontrados:
        <strong><%= libros.length %></strong>
    </p>

    <% if (libros.length === 0) { %>

        <p>
            No se encontraron libros.
        </p>

    <% } else { %>

        <table
            border="1"
            cellpadding="6"
        >

            <thead>

                <tr>
                    <th>Portada</th>
                    <th>ID</th>
                    <th>ISBN</th>
                    <th>TÃ­tulo</th>
                    <th>AÃ±o</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Formato</th>
                    <th>CategorÃ­a</th>
                    <th>Autores</th>
                    <th>GÃ©neros</th>
                    <th>Acciones</th>
                </tr>

            </thead>

            <tbody>

                <% libros.forEach(libro => { %>

                    <tr>

                        <td>

                            <% if (libro.portada) { %>

                                <img
                                    src="/library/<%= libro.portada %>"
                                    alt="<%= libro.portada_alt || libro.titulo %>"
                                    width="70"
                                >

                            <% } else { %>

                                Sin portada

                            <% } %>

                        </td>

                        <td>
                            <%= libro.libro_id %>
                        </td>

                        <td>
                            <%= libro.isbn %>
                        </td>

                        <td>
                            <%= libro.titulo %>
                        </td>

                        <td>
                            <%= libro.anio_publicacion %>
                        </td>

                        <td>
                            $<%= libro.precio %>
                        </td>

                        <td>
                            <%= libro.stock %>
                        </td>

                        <td>
                            <%= libro.formato %>
                        </td>

                        <td>
                            <%= libro.categoria %>
                        </td>

                        <td>
                            <%= libro.autores || '' %>
                        </td>

                        <td>
                            <%= libro.generos || '' %>
                        </td>

                        <td>

                            <a
                                href="/library/libro/<%= libro.libro_id %>"
                            >
                                Ver detalle
                            </a>

                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

    <hr>

    <form
        action="/library/logout"
        method="POST"
    >

        <button type="submit">
            Cerrar sesiÃ³n
        </button>

    </form>

</body>

</html>
