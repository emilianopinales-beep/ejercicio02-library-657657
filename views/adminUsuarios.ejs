<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Administrar usuarios</title>

    <link rel="stylesheet" href="/library/styles.css">

</head>

<body>

    <h1>Administrar usuarios</h1>

    <p>
        Administrador:
        <strong><%= usuario.nombre %></strong>
    </p>

    <p>
        <a href="/library/admin">
            Volver al panel
        </a>
    </p>

    <p>
        <a href="/library/admin/usuarios/nuevo">
            Nuevo usuario
        </a>
    </p>

    <hr>

    <h2>Usuarios registrados</h2>

    <table border="1" cellpadding="6">

        <thead>

            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Activo</th>
                <th>Fecha de registro</th>
                <th>Acciones</th>
            </tr>

        </thead>

        <tbody>

            <% usuarios.forEach(usuarioRegistro => { %>

                <tr>

                    <td>
                        <%= usuarioRegistro.usuario_id %>
                    </td>

                    <td>
                        <%= usuarioRegistro.nombre %>
                    </td>

                    <td>
                        <%= usuarioRegistro.email %>
                    </td>

                    <td>
                        <%= usuarioRegistro.rol %>
                    </td>

                    <td>
                        <%= usuarioRegistro.activo ? 'Sí' : 'No' %>
                    </td>

                    <td>
                        <%= usuarioRegistro.fecha_registro %>
                    </td>

                    <td>

                        <a
                            href="/library/admin/usuarios/<%= usuarioRegistro.usuario_id %>/editar"
                        >
                            Editar
                        </a>

                        <% if (usuario.usuario_id !== usuarioRegistro.usuario_id) { %>

                            <br><br>

                            <form
                                action="/library/admin/usuarios/<%= usuarioRegistro.usuario_id %>/eliminar"
                                method="POST"
                                onsubmit="return confirm('¿Seguro que deseas eliminar este usuario?');"
                            >

                                <button type="submit">
                                    Eliminar
                                </button>

                            </form>

                        <% } else { %>

                            <br><br>

                            Sesión actual

                        <% } %>

                    </td>

                </tr>

            <% }) %>

        </tbody>

    </table>

    <hr>

    <p>
        <a href="/library/admin">
            Volver al panel de administración
        </a>
    </p>

</body>

</html>
