<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Nuevo libro</title>

    <link rel="stylesheet" href="/library/styles.css">

</head>

<body>

    <h1>Nuevo libro</h1>

    <p>
        Administrador:
        <strong><%= usuario.nombre %></strong>
    </p>

    <p>
        <a href="/library/admin/libros">
            Volver a libros
        </a>
    </p>

    <hr>

    <form
        action="/library/admin/libros/nuevo"
        method="POST"
    >

        <p>
            <label for="isbn">
                ISBN:
            </label>
            <br>

            <input
                type="text"
                id="isbn"
                name="isbn"
                maxlength="20"
                required
            >
        </p>

        <p>
            <label for="titulo">
                Título:
            </label>
            <br>

            <input
                type="text"
                id="titulo"
                name="titulo"
                maxlength="200"
                required
            >
        </p>

        <p>
            <label for="anio_publicacion">
                Año de publicación:
            </label>
            <br>

            <input
                type="number"
                id="anio_publicacion"
                name="anio_publicacion"
                required
            >
        </p>

        <p>
            <label for="precio">
                Precio:
            </label>
            <br>

            <input
                type="number"
                id="precio"
                name="precio"
                min="0"
                step="0.01"
                required
            >
        </p>

        <p>
            <label for="stock">
                Stock:
            </label>
            <br>

            <input
                type="number"
                id="stock"
                name="stock"
                min="0"
                required
            >
        </p>

        <p>
            <label for="formato_id">
                Formato:
            </label>
            <br>

            <select
                id="formato_id"
                name="formato_id"
                required
            >

                <% formatos.forEach(formato => { %>

                    <option value="<%= formato.formato_id %>">
                        <%= formato.nombre %>
                    </option>

                <% }) %>

            </select>
        </p>

        <p>
            <label for="categoria_id">
                Categoría:
            </label>
            <br>

            <select
                id="categoria_id"
                name="categoria_id"
                required
            >

                <% categorias.forEach(categoria => { %>

                    <option value="<%= categoria.categoria_id %>">
                        <%= categoria.nombre %>
                    </option>

                <% }) %>

            </select>
        </p>

        <button type="submit">
            Crear libro
        </button>

    </form>

</body>

</html>
