�<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Detalle del libro</title>

    <link rel="stylesheet" href="/library/styles.css">

</head>

<body>

    <h1>Detalle del libro</h1>

    <p>
        Bienvenido,
        <strong><%= usuario.nombre %></strong>
    </p>

    <p>
        <a href="/library/catalogo">
            Volver al catálogo
        </a>
    </p>

    <% if (usuario.rol === 'administrador') { %>

        <p>
            <a href="/library/admin">
                Panel de administración
            </a>
        </p>

    <% } %>

    <hr>


    <!-- ================================================= -->
    <!-- PORTADA -->
    <!-- ================================================= -->

    <h2><%= libro.titulo %></h2>

    <% if (libro.portada) { %>

        <p>

            <img
                src="/library/<%= libro.portada %>"
                alt="<%= libro.portada_alt || libro.titulo %>"
                width="200"
            >

        </p>

    <% } else { %>

        <p>
            Este libro no tiene portada registrada.
        </p>

    <% } %>


    <!-- ================================================= -->
    <!-- DATOS DEL LIBRO -->
    <!-- ================================================= -->

    <h3>Información del libro</h3>

    <p>
        <strong>ISBN:</strong>
        <%= libro.isbn %>
    </p>

    <p>
        <strong>Año de publicación:</strong>
        <%= libro.anio_publicacion %>
    </p>

    <p>
        <strong>Precio:</strong>
        $<%= libro.precio %>
    </p>

    <p>
        <strong>Stock:</strong>
        <%= libro.stock %>
    </p>

    <p>
        <strong>Formato:</strong>
        <%= libro.formato %>
    </p>

    <p>
        <strong>Categoría:</strong>
        <%= libro.categoria %>
    </p>

    <p>
        <strong>Autores:</strong>
        <%= libro.autores || 'Sin autores asociados' %>
    </p>

    <p>
        <strong>Géneros:</strong>
        <%= libro.generos || 'Sin géneros asociados' %>
    </p>


    <hr>


    <!-- ================================================= -->
    <!-- CONCEPTOS -->
    <!-- ================================================= -->

    <h2>Conceptos asociados</h2>

    <% if (conceptos.length === 0) { %>

        <p>
            Este libro no tiene conceptos asociados.
        </p>

    <% } else { %>

        <% conceptos.forEach(concepto => { %>

            <div>

                <h3>
                    <%= concepto.nombre %>
                </h3>

                <p>
                    <strong>Definición:</strong>
                    <%= concepto.definicion %>
                </p>

                <% if (concepto.referencia) { %>

                    <p>
                        <strong>Referencia:</strong>
                        <%= concepto.referencia %>
                    </p>

                <% } %>

            </div>

            <br>

        <% }) %>

    <% } %>


    <hr>


    <!-- ================================================= -->
    <!-- GALERIA DE IMAGENES -->
    <!-- ================================================= -->

    <h2>Imágenes del libro</h2>

    <% if (imagenes.length === 0) { %>

        <p>
            Este libro no tiene imágenes registradas.
        </p>

    <% } else { %>

        <% imagenes.forEach(imagen => { %>

            <div>

                <img
                    src="/library/<%= imagen.ruta_relativa %>"
                    alt="<%= imagen.texto_alt || imagen.nombre_archivo %>"
                    width="180"
                >

                <p>
                    Archivo:
                    <%= imagen.nombre_archivo %>
                </p>

                <% if (imagen.es_portada) { %>

                    <p>
                        <strong>Portada principal</strong>
                    </p>

                <% } %>

                <% if (imagen.texto_alt) { %>

                    <p>
                        Texto alternativo:
                        <%= imagen.texto_alt %>
                    </p>

                <% } %>

            </div>

            <br>

        <% }) %>

    <% } %>


    <hr>

    <p>
        <a href="/library/catalogo">
            Volver al catálogo
        </a>
    </p>

    <form
        action="/library/logout"
        method="POST"
    >

        <button type="submit">
            Cerrar sesión
        </button>

    </form>

</body>

</html>
