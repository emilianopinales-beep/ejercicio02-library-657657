<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Panel de administración</title>

    <link rel="stylesheet" href="/library/styles.css">

</head>

<body>

    <h1>Panel de administración</h1>

    <p>
        Bienvenido,
        <strong><%= usuario.nombre %></strong>
    </p>

    <p>
        Rol:
        <strong><%= usuario.rol %></strong>
    </p>

    <hr>

    <h2>Administración de la librería</h2>

    <p>
        Desde este panel se administran los registros del sistema.
    </p>

    <ul>

        <li>
            <a href="/library/admin/libros">
                Libros
            </a>
        </li>

        <li>
            <a href="/library/admin/autores">
                Autores
            </a>
        </li>

        <li>
            <a href="/library/admin/catalogos/generos">
                Géneros
            </a>
        </li>

        <li>
            <a href="/library/admin/catalogos/formatos">
                Formatos
            </a>
        </li>

        <li>
            <a href="/library/admin/catalogos/categorias">
                Categorías
            </a>
        </li>

        <li>
            <a href="/library/admin/catalogos/conceptos">
                Conceptos
            </a>
        </li>

        <li>
            <a href="/library/admin/imagenes">
                Imágenes
            </a>
        </li>

        <li>
            <a href="/library/admin/usuarios">
                Usuarios
            </a>
        </li>

    </ul>

    <hr>

    <p>
        <a href="/library/catalogo">
            Ir al catálogo
        </a>
    </p>

    <form
        action="/library/logout"
        method="POST"
    >

        <button type="submit">
            Cerrar sesión
        </button>

    </form>

</body>

</html>
